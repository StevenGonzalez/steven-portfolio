// Type-checks the world's engine, which is plain JavaScript, with the browser's types. Strict, except that a value with
// no type written for it is allowed to be anything: the engine's types are inferred, and JSDoc says only what inference
// can't work out. The workers are checked here too; they only use what a window also has.
{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowJs": true,
    "checkJs": true,
    "strict": true,
    "noImplicitAny": false,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "types": []
  },
  "include": ["*.js"]
}
